{
  "name": "rifq-muslim",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "RIFQ Muslim (رِفْق مسلم) — a multilingual Islamic PWA",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "node server.js",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "data:quran": "node scripts/fetch-quran.mjs",
    "data:hadith": "node scripts/fetch-hadith.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.8"
  }
}
